# Condor submit file, step 1: one job per day of poet_days.txt (downloads from JSOC: internet needed)
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/poet_day.sh

# $1 = OMP_NUM_THREADS, $2 = day
Arguments = "2 $(day)"

# at most this many days at the same time (JSOC serves a limited bandwidth: do not open too many connections)
max_materialize = 6
RequestCpus   = 2
RequestMemory = 10GB
RequestDisk   = 2GB

Log    = logs/poet_day_$(day).log
Output = logs/poet_day_$(day).out
Error  = logs/poet_day_$(day).err

stream_output = True
stream_error  = True

Queue day from poet_days.txt
