# Condor submit file, step 2 of sweep_45_dumusque_mu.dag (Dumusque bisector times mu): one simulation per line of
# parameters_fraction.txt (noise_th, I_th, B_sat, Temp), after build_grids_45_dumusque_mu.sub
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/run_opt_rv_45_dumusque_mu.sh

# $1 = kind, $2 = OMP_NUM_THREADS, $3 = noise_th, $4 = I_th, $5 = B_sat, $6 = Temp
Arguments = "fraction 8 $(noise_th) $(I_th) $(B_sat) $(Temp)"

max_materialize = 50
RequestCpus   = 8
RequestMemory = 16GB
RequestDisk   = 1GB

Log    = logs/45_dumusque_mu_fraction_noise_$(noise_th)_I_$(I_th)_Bsat_$(B_sat)_T_$(Temp).log
Output = logs/45_dumusque_mu_fraction_noise_$(noise_th)_I_$(I_th)_Bsat_$(B_sat)_T_$(Temp).out
Error  = logs/45_dumusque_mu_fraction_noise_$(noise_th)_I_$(I_th)_Bsat_$(B_sat)_T_$(Temp).err

stream_output = True
stream_error  = True

Queue noise_th, I_th, B_sat, Temp from parameters_fraction.txt
