# Condor submit file, step 3 of sweep_noise.dag: the days still missing and the filling factors of every set of the
# parameter file of $(kind) (after identify_noise.sub), in 40 jobs (N_AGGREGATE of settings_noise.sh: keep the two
# equal). kind (plage or fraction) comes from the VARS of the DAG.
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/aggregate_noise.sh

# $1 = kind, $2 = workers (days still missing, if a block of identify_noise.sub failed), $3 = job, $4 = n_jobs (= Queue)
Arguments  = "$(kind) 2 $(Process) 40"

RequestCpus   = 2
RequestMemory = 24GB
RequestDisk   = 1GB

Log    = logs/aggregate_noise_$(kind)_$(Process).log
Output = logs/aggregate_noise_$(kind)_$(Process).out
Error  = logs/aggregate_noise_$(kind)_$(Process).err

stream_output = True
stream_error  = True

Queue 40
