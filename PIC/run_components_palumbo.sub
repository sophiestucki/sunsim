# Condor submit file, step 2 of sweep_components_palumbo.dag: the simulation of every part, one job per line of
# parameters_components.txt with the bisector palumbo (jobs_components_palumbo.txt, written by
# jobs_components_palumbo.sh), after build_grids_components_palumbo.sub (and aggregate_components.sub of
# sweep_components.dag)
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/run_components.sh

# $1 = OMP_NUM_THREADS, $2 = noise_th, $3 = I_th, $4 = A_th, $5 = Temp, $6 = bisector
Arguments = "8 $(noise_th) $(I_th) $(A_th) $(Temp) $(bisector)"

max_materialize = 50
RequestCpus   = 8
RequestMemory = 16GB
RequestDisk   = 1GB

Log    = logs/components_noise_$(noise_th)_I_$(I_th)_A_$(A_th)_T_$(Temp)_$(bisector).log
Output = logs/components_noise_$(noise_th)_I_$(I_th)_A_$(A_th)_T_$(Temp)_$(bisector).out
Error  = logs/components_noise_$(noise_th)_I_$(I_th)_A_$(A_th)_T_$(Temp)_$(bisector).err

stream_output = True
stream_error  = True

Queue noise_th, I_th, A_th, Temp, bisector from jobs_components_palumbo.txt
