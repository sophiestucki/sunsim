# Condor submit file, step 1 of sweep_components.dag: the grids (N_RINGS of settings_components.sh) of every Temp of
# parameters_components.txt, one job per spot bisector (jobs_components_bisectors.txt, written by jobs_components.sh)
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/build_grids_components.sh
Arguments  = "1 $(bisector)"

RequestCpus   = 10
RequestMemory = 16GB
RequestDisk   = 10GB

Log    = logs/build_grids_components_$(bisector).log
Output = logs/build_grids_components_$(bisector).out
Error  = logs/build_grids_components_$(bisector).err

Queue bisector from jobs_components_bisectors.txt
