# Condor submit file, step 4 of sweep_720.dag: one simulation per line of parameters_720_fraction.txt
# (noise_th, I_th, B_sat, Temp), after build_grids_720.sub and aggregate_720.sub
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/run_opt_rv_720.sh

# $1 = kind, $2 = OMP_NUM_THREADS, $3 = noise_th, $4 = I_th, $5 = B_sat, $6 = Temp
Arguments = "fraction 8 $(noise_th) $(I_th) $(B_sat) $(Temp)"

max_materialize = 50
RequestCpus   = 8
RequestMemory = 24GB
RequestDisk   = 1GB

Log    = logs/720_fraction_noise_$(noise_th)_I_$(I_th)_Bsat_$(B_sat)_T_$(Temp).log
Output = logs/720_fraction_noise_$(noise_th)_I_$(I_th)_Bsat_$(B_sat)_T_$(Temp).out
Error  = logs/720_fraction_noise_$(noise_th)_I_$(I_th)_Bsat_$(B_sat)_T_$(Temp).err

stream_output = True
stream_error  = True

Queue noise_th, I_th, B_sat, Temp from parameters_720_fraction.txt
