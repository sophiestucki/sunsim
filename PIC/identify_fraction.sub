# Condor submit file, step 2: identification at 4096 px with facular fractions of the decade in 80 blocks of days
# (N_BLOCKS of settings_fraction.sh: keep the two equal), all the sets of thresholds of parameters_fraction.txt at once
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/identify_fraction.sh

# $1 = workers (days at the same time in the job: ~3 GB of memory each on PIC; the days are independent, the job
# uses all its CPUs: ~19 s per day and worker with the 100 sets), $2 = block
Arguments = "4 $(Process)"

RequestCpus   = 4
RequestMemory = 16GB
RequestDisk   = 1GB

Log    = logs/identify_fraction_$(Process).log
Output = logs/identify_fraction_$(Process).out
Error  = logs/identify_fraction_$(Process).err

stream_output = True
stream_error  = True

Queue 80
