# Condor submit file, step 4 of sweep_720.dag: one simulation per line of parameters_720_plage.txt
# (noise_th, I_th, A_th, Temp), after build_grids_720.sub and aggregate_720.sub
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/run_opt_rv_720.sh

# $1 = kind, $2 = OMP_NUM_THREADS, $3 = noise_th, $4 = I_th, $5 = A_th, $6 = Temp
Arguments = "plage 8 $(noise_th) $(I_th) $(A_th) $(Temp)"

max_materialize = 50
RequestCpus   = 8
RequestMemory = 16GB
RequestDisk   = 1GB

Log    = logs/720_plage_noise_$(noise_th)_I_$(I_th)_A_$(A_th)_T_$(Temp).log
Output = logs/720_plage_noise_$(noise_th)_I_$(I_th)_A_$(A_th)_T_$(Temp).out
Error  = logs/720_plage_noise_$(noise_th)_I_$(I_th)_A_$(A_th)_T_$(Temp).err

stream_output = True
stream_error  = True

Queue noise_th, I_th, A_th, Temp from parameters_720_plage.txt
