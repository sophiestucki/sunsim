# Condor submit file, step 3: the days still missing and the filling factors of every set (after identify_fraction.sub),
# in N_JOBS jobs: job k does the sets k, k + N_JOBS, ... of the (I_th, B_sat) pairs of parameters_fraction.txt (writing
# the filling factors of a set takes ~1.5 min on one core, mostly reading its ~3100 days). N_JOBS = 100: one set per job
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/aggregate_fraction.sh

# $1 = workers (days still missing, if a block of identify_fraction.sub failed), $2 = job, $3 = N_JOBS (= Queue)
Arguments  = "2 $(Process) 100"

RequestCpus   = 2
RequestMemory = 24GB
RequestDisk   = 1GB

Log    = logs/aggregate_fraction_$(Process).log
Output = logs/aggregate_fraction_$(Process).out
Error  = logs/aggregate_fraction_$(Process).err

stream_output = True
stream_error  = True

Queue 100
