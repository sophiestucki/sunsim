# Condor submit file, step 2: one job per line of parameters_2.txt (noise_th, I_th, A_th, Temp), after build_grids.sub
Universe   = vanilla
Executable = /data/spotless/scratch/sstucki/starsim/pipelines/run_10_opt_rv.sh

# Arguments passed to the .sh:
# $1 = OMP_NUM_THREADS
# $2 = noise_th
# $3 = I_th
# $4 = A_th
# $5 = Temp

Arguments = "1 $(noise_th) $(I_th) $(A_th) $(Temp)"
#Arguments = "1 8 0.80 1 300"

max_materialize = 30
RequestCpus   = 1
RequestMemory = 4GB
RequestDisk   = 1GB

# One output/error/log file per parameter combination
Log    = logs/noise_$(noise_th)_I_$(I_th)_A_$(A_th)_T_$(Temp).log
Output = logs/noise_$(noise_th)_I_$(I_th)_A_$(A_th)_T_$(Temp).out
Error  = logs/noise_$(noise_th)_I_$(I_th)_A_$(A_th)_T_$(Temp).err

stream_output = True
stream_error  = True

Queue noise_th, I_th, A_th, Temp from parameters_2.txt
