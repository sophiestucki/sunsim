# Condor submit file, step 2 of sweep_noise.dag: identification at 4096 px in 80 blocks of days (N_BLOCKS of
# settings_noise.sh: keep the two equal), the sets of the parameter file of $(kind) at once. kind (plage or fraction)
# comes from the VARS of the DAG.
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/identify_noise.sh

# $1 = kind, $2 = workers (days at the same time in the job: ~3-4 GB of memory each at 4096 px), $3 = block
Arguments = "$(kind) 4 $(Process)"

RequestCpus   = 4
RequestMemory = 20GB
RequestDisk   = 1GB

Log    = logs/identify_noise_$(kind)_$(Process).log
Output = logs/identify_noise_$(kind)_$(Process).out
Error  = logs/identify_noise_$(kind)_$(Process).err

stream_output = True
stream_error  = True

Queue 80
