# Condor submit file, step 3 of sweep_720.dag: the days still missing and the filling factors of every set of the
# parameter file of $(kind) (after identify_720.sub), in 40 jobs (N_AGGREGATE of settings_720.sh: keep the two equal; ~1.5 min per set at 60 rings).
# kind (plage or fraction) comes from the VARS of the DAG.
Universe   = vanilla
Executable = /nfs/pic.es/user/s/sstucki/sunsim/PIC/aggregate_720.sh

# $1 = kind, $2 = workers (days still missing, if a block of identify_720.sub failed), $3 = job, $4 = n_jobs (= Queue)
Arguments  = "$(kind) 2 $(Process) 40"

RequestCpus   = 2
RequestMemory = 24GB
RequestDisk   = 1GB

Log    = logs/aggregate_720_$(kind)_$(Process).log
Output = logs/aggregate_720_$(kind)_$(Process).out
Error  = logs/aggregate_720_$(kind)_$(Process).err

stream_output = True
stream_error  = True

Queue 40
